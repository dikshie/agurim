# Google ADK / Gemini API Configuration
# Option 1: Google AI Studio API Key (recommended for quickstart)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Google Cloud Vertex AI
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Agurim Engine Configuration
AGURIM_AGENT_MODEL=gemini-2.5-flash
AGURIM_BIN=./src/agurim
AGURIM_DATA_DIR=./data_dir
